# Cherry AI local configuration
CHERRY_APP_ENV=development
CHERRY_DEBUG=true
CHERRY_LOG_LEVEL=INFO
CHERRY_SQL_ECHO=false

# Optional override. Defaults to the project directory when not set.
# CHERRY_PROJECT_ROOT=C:\Cherry AI

# Runtime data. Defaults to <project-root>\.cherry_data.
# CHERRY_DATA_DIR=C:\Cherry AI\.cherry_data

# SQLite database URL. Defaults to sqlite:///<data-dir>/cherry_ai.db.
# CHERRY_DATABASE_URL=sqlite:///C:/Cherry AI/.cherry_data/cherry_ai.db

# Ollama local model settings
CHERRY_OLLAMA_HOST=http://localhost:11434
CHERRY_OLLAMA_MODEL=llama3.1
CHERRY_OLLAMA_TIMEOUT_SECONDS=30
CHERRY_OLLAMA_MAX_RETRIES=1

# Desktop automation safety
CHERRY_PYAUTOGUI_FAILSAFE=true
CHERRY_PYAUTOGUI_PAUSE_SECONDS=0.1

# Observer engine
CHERRY_OBSERVER_ENABLED=true
CHERRY_OBSERVER_POLL_INTERVAL_SECONDS=2
CHERRY_IDLE_THRESHOLD_SECONDS=300
CHERRY_DISTRACTION_KEYWORDS=YouTube,Netflix,Instagram,TikTok,Reddit

# Automation engine
CHERRY_AUTOMATION_ENABLED=true
CHERRY_AUTOMATION_TIMEOUT_SECONDS=10
CHERRY_SCREENSHOT_DIR=
# Semicolon-separated aliases, e.g. notes=C:\Windows\notepad.exe;terminal=wt.exe
CHERRY_CUSTOM_APP_MAPPINGS=

# Proactive intelligence
CHERRY_PROACTIVE_ENABLED=true
CHERRY_PROACTIVE_REFRESH_INTERVAL_SECONDS=30
CHERRY_PRODUCTIVITY_DAILY_TASK_TARGET=3
CHERRY_PRODUCTIVITY_DAILY_STUDY_TARGET_MINUTES=90
CHERRY_FOCUS_TARGET_MINUTES=45
CHERRY_FOCUS_BREAK_AFTER_MINUTES=50
CHERRY_DISTRACTION_THRESHOLD=3
CHERRY_RECOMMENDATION_COOLDOWN_SECONDS=900
CHERRY_NOTIFICATION_GLOBAL_COOLDOWN_SECONDS=300
CHERRY_NOTIFICATION_DUPLICATE_WINDOW_SECONDS=1800
CHERRY_NOTIFICATION_QUIET_MODE_ENABLED=true
CHERRY_NOTIFICATION_QUIET_HOURS_START=22:00
CHERRY_NOTIFICATION_QUIET_HOURS_END=07:00

# Advanced memory and context
CHERRY_MEMORY_ENABLED=true
CHERRY_MEMORY_RECENT_TASK_LIMIT=5
CHERRY_MEMORY_RECENT_INTERACTION_LIMIT=6
CHERRY_MEMORY_BEHAVIORAL_PATTERN_LIMIT=5
CHERRY_MEMORY_PRODUCTIVITY_SUMMARY_LIMIT=3
CHERRY_MEMORY_CONTEXT_MAX_CHARS=1800
CHERRY_MEMORY_RETENTION_DAYS=180
CHERRY_WORKING_MEMORY_TTL_MINUTES=240
CHERRY_SEMANTIC_MEMORY_MIN_CONFIDENCE=0.35
CHERRY_MEMORY_PRUNE_BATCH_SIZE=100
